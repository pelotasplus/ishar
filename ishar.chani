attr[seg_0000:2915]: type = code; name = vm_op_eval_reset; comment = [[[
    Opcode 0x1e. Resets the evaluation stack pointer (bx = 277ch, the stack base)
    and calls the expression evaluator at 069a9, falling through into 291b.
]]]
attr[seg_0000:291b]: type = code
attr[seg_0000:2937]: type = code; name = vm_stmt_eval; comment = [[[
    Statement: set the eval stack (BX = 0x277c) and run the expression evaluator.
]]]
attr[seg_0000:293d]: type = code; name = vm_stmt_assign; comment = [[[
    Statement: evaluate an expression, swap the two string workspace pointers ss:[0c58]/ss:[0c5c], then dispatch an assignment opcode through vm_store_table at cs:[02d8].
]]]
attr[seg_0000:2943]: type = code
attr[seg_0000:295f]: type = code; name = vm_stmt_assign_neg; comment = [[[
    As vm_stmt_assign with the accumulator negated first.
]]]
attr[seg_0000:296b]: type = code; name = vm_prim_5args; comment = [[[
    Engine primitive taking five script arguments: calls the expression evaluator five times and stores the results into the engine variable block (word, word, byte, byte, word).
]]]
attr[seg_0000:2994]: type = code; name = vm_prim_4args; comment = [[[
