project[ishar]:

arch = 8086

// The unpacked image. Rebuild it with tools/unpack.py; it is derived and not
// committed. sha1 425a39733144b2edeba813a6608f741a26ef937f.
file[exe]:
    format = bin
    path   = ishar_legend_of_the_fortress_DOSGamer.com/start-unpacked.exe
end

// Segments and far-call seeds below were generated by tools/segmap.py from the
// rebuilt relocation table. Regenerate with `tools/segmap.py` and merge by hand:
// everything after them is hand-written.
//
// A segment name is the paragraph offset into the image, which is also
// (runtime CS - load): the game segment seen as 0abe in Spice86 with load 017d
// is seg_0941. tools/addr.py does that conversion.

// 4 code segments, 4 data-only, image 0x15a26 -- generated by tools/segmap.py
// entry 0000:25e5

segment[seg_0000]:
    type   = code
    load   = [0..]:exe[0x00250..0x09660]
end

segment[seg_0941]:
    type   = code
    load   = [0..]:exe[0x09660..0x0ebc0]
end

segment[seg_0e97]:
    type   = code
    load   = [0..]:exe[0x0ebc0..0x13fc0]
end

segment[seg_13d7]:
    type   = code
    load   = [0..]:exe[0x13fc0..0x15c76]
end

