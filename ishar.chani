// ---- hand annotations ----
// The launcher's keyboard layer (FINDINGS.md 2.1). It hooks INT 9, reads port
// 0x60 itself and translates through its own table, so DOS and the BIOS never
// see the game's keys.

attr[seg_0000:1072]: name = int9_keyboard_isr; comment = [[[
    INT 9 handler. Reads the scancode from port 0x60, indexes BX = (code & 0x7f) - 1,
    sets or clears the key-down flag at key_down_flags[BX], looks up
    scancode_to_char[BX] and stores it in last_key_char unless it is 0xfe, then
    chains to the handler saved at prev_int9_vector.
]]]
attr[seg_0000:0314]: type = u32; name = prev_int9_vector; comment = [[[
    Far pointer to the previous INT 9 handler; the ISR ends `jmp far CS:[0314]`.
]]]
attr[seg_0000:0318]: type = u8; name = last_key_char; comment = [[[
    Translated character of the most recent key, or 0 on release. The language
    menu reads this: with the shipped table, top-row 1 delivers '&' (0x26), which
    is why only the keypad worked.
]]]
attr[seg_0000:031a]: type = [u8; 112]; name = key_down_flags; comment = [[[
    One byte per scancode-1, set on make and cleared on break.
]]]
attr[seg_0000:04be]: type = [u8; 112]; name = scancode_to_char; comment = [[[
    Scancode-to-character table, entry N = scancode N+1. Letter rows are QWERTY
    but the number row is French: sc 02..0b give & e-acute " ' ( ` e-grave ! c-cedilla
    a-grave. There is no shifted variant, so the top row can never produce a digit.
    remap-digits.sh rewrites entries 1..10 to '1'..'0' at runtime.
    0xfe marks "no character".
]]]
attr[seg_0000:0d98]: name = timer_isr_launcher; comment = [[[
    The launcher's INT 8 handler: saves every register, sets DS = 0x0c0b, and runs
    the timer work. Its offset is the one that appears in the failing vector during
    the crash of FINDINGS.md 5.1, paired there with the game's segment instead of
    this one. Deliberately carries no `type = code`: chani panics on a code seed
    here (see the footer above).
]]]


// DOS file access, located by tracing INT 21h and reading the return address off
// the interrupt frame (tools/gdbtrace.py). These are the addresses execution
// RESUMES at, so each sits immediately after the `int 21h` of the named call --
// the routine itself starts earlier and is not yet delimited.

attr[seg_13d7:0e9f]: name = after_open_start_stp; comment = [[[
    Returns here from INT 21h AH=3D opening START.STP -- the first file the
    program touches, before any asset.
]]]
attr[seg_13d7:0eb4]: name = after_read_start_stp; comment = [[[
    Returns here from AH=3F reading the 14-byte settings string into 1554:0386.
    The buffer around it also holds the setup screen's text (VIDEO / CGA / EGA /
    "to select options, ENTER to validate"), so the settings parser and the setup
    UI live together in this segment.
]]]
attr[seg_13d7:0ebd]: name = after_close_start_stp
attr[seg_0000:21a9]: name = after_create_cd_tst; comment = [[[
    Returns here from AH=3C creating cd.tst -- a writability probe of the drive,
    done 24 times in a row in the very first traced boot.
]]]
attr[seg_0000:1feb]: name = after_dos_open; comment = [[[
    Returns here from AH=3D. The asset loader's open: seen for blancpc.io,
    MAIN.IO and logo.IO, so this is the single path assets come through.
]]]
attr[seg_0000:2136]: name = after_dos_read; comment = [[[
    Returns here from AH=3F. Reads a whole small file (blancpc.io, 2500 bytes to
    1123:0000) or a chunk of a large one (8000 bytes to e000:0000), and reads the
    6-byte and 16-byte headers of MAIN.IO into the scratch buffer at 0d88:2480.
    The container decoder is upstream of this address -- this is where to start
    looking for it (T10).
]]]
attr[seg_0000:20be]: name = after_dos_close

// code seeds for the DOS call sites above
attr[seg_13d7:0e9f]: type = code
attr[seg_13d7:0eb4]: type = code
attr[seg_13d7:0ebd]: type = code
attr[seg_0000:21a9]: type = code
attr[seg_0000:1feb]: type = code
attr[seg_0000:2136]: type = code
attr[seg_0000:20be]: type = code
// the DOS asset path, seeded at the instruction that sets up each call
attr[seg_0000:1fdf]: type = code; name = dos_open_asset; comment = Opens an asset: pushes the name pointer, AX=0x3d02, INT 21h, stores the handle at ss:[0bbe]. Every asset seen loading -- blancpc.io, MAIN.IO, logo.IO -- comes through here.
attr[seg_0000:212d]: type = code; name = dos_read_asset; comment = Reads into the caller's buffer: BX from ss:[0bbe], AH=0x3f, INT 21h. Used for the 6-byte and 16-byte headers and for the 8000-byte payload chunks.
attr[seg_0000:20b5]: type = code; name = dos_close_asset; comment = Closes the handle at ss:[0bbe].
attr[seg_0000:21a0]: type = code; name = dos_create_cd_tst; comment = Creates cd.tst then immediately closes it -- the drive writability probe.
// the .io container: loader, RLE decoder, and its byte stream (T10)
attr[seg_0000:76bc]: type = code; name = load_container; comment = [[[
    Loads an .io container. Reads a 6-byte header into ss:2480, then a 16-byte block of counts into ss:2486, and carves the destination memory into sub-arrays from those counts: ss:[2486] sizes one region, ss:[2488] counts 6-byte elements, ss:[248e] a region rounded to paragraphs, ss:[2492] counts 0x26-byte elements. The 16 bytes are a directory, not compression.
]]]
attr[seg_0000:76b4]: type = cstr; name = fname_main_io
attr[seg_0000:7a79]: type = code; name = rle_decode_loop; comment = [[[
    The container's decompressor: byte-oriented RLE, one pass per plane. ss:[0b18] counts planes down; ss:[0b57] selects how many -- 0x80 gives 1, 0xa0 gives 2 (and takes the special path at 0x7b85), anything else 8. Each control byte c: if c < 0x80 it is a literal run of c+1 bytes, taken from the stream and written out one at a time; c >= 0x80 takes the branch at 0x7aa3. Input comes from get_byte, output goes through put_byte.
]]]
attr[seg_0000:7ade]: type = code; name = get_byte; comment = [[[
    Fetch one input byte. If BX has reached the end of the buffer (ss:[0b3a]) it refills first via read_next_chunk, otherwise it takes es:[bx], stashes it at ss:[0b12] and advances BX.
]]]
attr[seg_0000:7aee]: type = code; name = refill_chunk_c_unobserved; comment = [[[
    NOT the refill main.io or logo.io use -- see refill_chunk_a and _b, which the
    stack says are the real ones. Kept because it is the same shape and belongs to
    a third decoder, but nothing has been seen to reach it.
    Refill the input buffer: 0x1f40 (8000) bytes through dos_read_asset into the buffer at ss:[0b5a]. This is why a traced load shows repeated 8000-byte reads into the same address -- it is a stream, not a layout.
]]]
attr[seg_0000:7b06]: type = code; name = put_byte; comment = [[[
    Write one decoded byte to ds:[si], bounds-checked against the segment limit cached at cs:[79e7] and against DI.
]]]
// T10b: the refill helpers actually used, named by reading one word further
// up the stack than the INT frame.
attr[seg_0000:7b99]: type = code; name = refill_chunk_a; comment = [[[
    Refill used for the FIRST 8000-byte chunk of both main.io and logo.io (observed outer caller 0x7bb1). Saves every register, reads 0x1f40 bytes through dos_read_asset into the buffer at ss:[0b5a].
]]]
attr[seg_0000:7d26]: type = code; name = refill_chunk_b; comment = [[[
    Refill used for the SECOND chunk of both files (observed outer caller 0x7d3e). Same shape as refill_chunk_a, different decoder around it -- a file is consumed by more than one decoder in sequence.
]]]
attr[seg_0000:791a]: type = code; name = load_logo_io; comment = [[[
    Drove the open of logo.IO (observed outer caller of the AH=3D). Reads a 6-byte header at 0x7924 and then chunks -- no 16-byte directory, unlike main.io.
]]]
attr[seg_0000:7839]: type = code; name = close_after_load; comment = [[[
    Closed main.io after its chunks were consumed.
]]]
attr[seg_0000:6f62]: type = code; name = find_asset; comment = [[[
    Drove the AH=4E findfirst probes for main.io and mcave.io.
]]]
attr[seg_0000:06d3]: type = code; name = load_small_file; comment = [[[
    Read blancpc.io whole -- 2500 bytes in one call, no chunking.
]]]
attr[seg_13d7:0386]: type = [u8; 14]; name = stp_settings; comment = [[[
    The 14 bytes of START.STP, read here by the code at 0x0eb4 (T07 trace).
    On disk: "RBVVSAP1J0M1KQ".
]]]
// T09b: START.STP and the settings it sets. All in seg_13d7, addressed
// through CS by the parser itself.
attr[seg_13d7:0e96]: type = code; name = load_settings; comment = [[[
    Opens START.STP (AL=0x82, name at 0x036c), reads 14 bytes to stp_settings, closes, then validates and parses. On any DOS error it jumps to 0x0fde and sets settings_invalid.
]]]
attr[seg_13d7:036c]: type = cstr; name = fname_start_stp; comment = [[[
    'START.STP', the name passed to INT 21h AH=3D.
]]]
attr[seg_13d7:03a6]: type = u8; name = cfg_video; comment = [[[
    Video: 0 CGA, 1 EGA, 2 VGA, 3 Hercules. From the letter at stp_settings+3 (C/E/V/H); anything else gives 3. Values >= 4 are replaced from the default at 0x03ef.
]]]
attr[seg_13d7:05fc]: type = u8; name = cfg_sound; comment = [[[
    Sound device from the letter at stp_settings+5: I=0, A=1 (AdLib), B=2, N=3, G=4, C=4 (and also sets 0x0b8e to 8, so C and G share a value and are told apart by that byte). Values >= 5 are replaced from the default at 0x0657.
]]]
attr[seg_13d7:066a]: type = u8; name = cfg_port; comment = [[[
    Port, from the digit at stp_settings+7 minus '1'. Values >= 4 replaced from the default at 0x06b3.
]]]
attr[seg_13d7:0402]: type = u8; name = cfg_joystick; comment = [[[
    Joystick, from the digit at stp_settings+9 minus '0'. Range-checked against 3.
]]]
attr[seg_13d7:048a]: type = u8; name = cfg_mouse; comment = [[[
    Mouse, from the digit at stp_settings+11 minus '0'. Values >= 2 replaced from the default at 0x0523.
]]]
attr[seg_13d7:0574]: type = u8; name = cfg_keyboard; comment = [[[
    Keyboard layout from the letter at stp_settings+13: A=0 (AZERTY), Q=1 (QWERTY), Z=2 (QWERTZ); anything else gives 0. This is the setting behind the scancode table in FINDINGS 2.1.
]]]
attr[seg_13d7:0b90]: type = u8; name = settings_invalid; comment = [[[
    Set to 1 when START.STP cannot be opened, read, closed, or fails the key-letter check; the parser then leaves every cfg_* at its default.
]]]
// The asset catalogue: files are addressed by numeric id, not by name.
attr[seg_0000:78f9]: type = code; name = load_asset_by_id; comment = [[[
    Entry point for loading an asset. ss:[0b04] holds the id: 0 means main.io itself (jumps to load_container), anything else is looked up with find_asset_record and then loaded with a 6-byte header read.
]]]
attr[seg_0000:8106]: type = code; name = find_asset_record; comment = [[[
    Walks the index of far pointers at ss:[0bc2], ss:[0bce] entries of 4 bytes each, comparing AX against the first word of each record (its id). Returns the record's far address in DX:AX, or AX=0xffff if the id is not present. This is why only three filenames exist in the binary -- everything else is reached by id through main.io's catalogue.
]]]
// The 6-byte asset header, read to ss:2480 before anything else (T11c).
// DGROUP variables. These are `ss:XXXX` in the code; SS is load+0x0c0b at runtime
// (0x0c0b is one of the data-only paragraphs segmap found), so the listing address
// is image 0x0c0b0 + XXXX, which lands inside seg_0941.
attr[seg_0941:5120]: type = u16; name = hdr_size; comment = [[[
    ss:2480. Asset header word 0: total size, headers included; 22 subtracted on the catalogue path, 6 on the direct one.
]]]
attr[seg_0941:5122]: type = u16; name = hdr_mode; comment = [[[
    ss:2482. Header word 1; high byte `and 0feh` becomes decoder_mode. 0xa0 in 97 of 106 files.
]]]
attr[seg_0941:5124]: type = u16; name = hdr_is_catalogue; comment = [[[
    ss:2484. Header word 2: zero means read the 16-byte directory and treat this as the catalogue; non-zero means decode directly. Zero in only main.io and four .fic files.
]]]
attr[seg_0941:5126]: type = [u16; 8]; name = catalogue_counts; comment = [[[
    ss:2486. The 16-byte directory, read only when hdr_is_catalogue is zero: eight counts that size the sub-arrays load_container carves.
]]]
attr[seg_0941:37a4]: type = u16; name = asset_id_wanted; comment = [[[
    ss:0b04. The id passed to load_asset_by_id; 0 selects main.io.
]]]
attr[seg_0941:3862]: type = u16; name = asset_index_ptr; comment = [[[
    ss:0bc2. Offset of the index of far pointers to asset records.
]]]
attr[seg_0941:386e]: type = u16; name = asset_index_count; comment = [[[
    ss:0bce. Number of entries in that index.
]]]
attr[seg_0941:37f7]: type = u8; name = decoder_mode; comment = [[[
    ss:0b57. The decoder's pass count selector: 0x80 one pass, 0xa0 two, anything else eight.
]]]
// The drawing system (T11i).
attr[seg_0e97:0148]: type = code; name = blit_rect; comment = [[[
    Copies a rectangle between two buffers: source far pointer ss:[0b88], destination ss:[0b84], both using the same row stride ss:[1dd5]. The rectangle comes from the clip variables -- offset = top*stride + left, width = right-left+1 halved into words, height = bottom-top+1. Used for page work rather than for drawing a sprite.
]]]
attr[seg_0000:1ee2]: type = code; name = set_full_screen_clip; comment = [[[
    Sets the clip rectangle to the whole mode-13h screen: left 0, top 0, right 0x13f (319), bottom 0xc7 (199).
]]]
attr[seg_0941:37fc]: type = u16; name = clip_left; comment = [[[
    ss:[0c1a]. Left edge of the clip rectangle used by blit_rect.
]]]
attr[seg_0941:37fe]: type = u16; name = clip_top; comment = [[[
    ss:[0c1c]. Top edge.
]]]
attr[seg_0941:3800]: type = u16; name = clip_right; comment = [[[
    ss:[0c1e]. Right edge, inclusive -- 319 for the full screen.
]]]
attr[seg_0941:3802]: type = u16; name = clip_bottom; comment = [[[
    ss:[0c20]. Bottom edge, inclusive -- 199.
]]]
attr[seg_0941:3466]: type = u16; name = draw_target_off; comment = [[[
    ss:[0b84]. Offset of the far pointer drawing goes to; set to 0 with A000 after the mode switch, and swapped at seg_0000:4370 so the game can draw off-screen.
]]]
attr[seg_0941:3468]: type = u16; name = draw_target_seg; comment = [[[
    ss:[0b86]. Segment half of that pointer: 0xa000 for the visible screen.
]]]
attr[seg_0941:46b5]: type = u16; name = row_stride; comment = [[[
    ss:[1dd5]. Bytes per output row: 0x140 (320) in mode 13h. Both blitters use it for source and destination alike.
]]]
end
