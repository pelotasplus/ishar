#!/bin/sh
# Refuses a commit that leaves a finding stranded. Both failures below are silent
# otherwise, and both happened repeatedly while the prose rule telling us to avoid
# them was already in CLAUDE.md.
#
# Enable once per clone:   git config core.hooksPath .githooks
# Bypass deliberately:     git commit --no-verify

fail=0

# 1. An asset offset named in the prose that never reached FILES.md.
if git diff --cached --name-only | grep -qE '^(FINDINGS|FORMATS|REBUILD)\.md$'; then
  if ! python3 tools/checkdocs.py; then
    echo
    echo "pre-commit: a finding names an asset offset that FILES.md will not show."
    fail=1
  fi
fi

# 2. The same address annotated twice in the database, each copy with a name.
if git diff --cached --name-only | grep -q '^ishar\.chani$'; then
  dups=$(grep -o '^attr\[[^]]*\]' ishar.chani | sort | uniq -d | while read -r a; do
           n=$(grep -c "^$(printf '%s' "$a" | sed 's/[][\\.*^$/]/\\&/g').*name *=" ishar.chani)
           [ "$n" -gt 1 ] && echo "$a"
         done)
  if [ -n "$dups" ]; then
    echo "pre-commit: these addresses carry two NAMED annotations:"
    echo "$dups" | sed 's/^/  /'
    echo "Merge them -- the older half is where a superseded claim hides."
    fail=1
  fi
fi

# 3. A tool added or changed without TOOLS.md following, or with no docstring.
if git diff --cached --name-only | grep -q '^tools/'; then
  if ! python3 tools/toolsindex.py --check; then
    echo "pre-commit: run tools/toolsindex.py, and give every tool a docstring."
    fail=1
  fi
fi

exit $fail
